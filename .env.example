# Supabase Configuration
# Find these at: https://app.supabase.com -> Settings -> API
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Venice AI Configuration
# Find this at: https://venice.ai/settings/api
VITE_VENICE_API_KEY=your_venice_api_key

# Prayer Limits & Token System
# Maximum characters allowed per prayer
VITE_MAX_PRAYER_CHARS=1500
# Daily token budget per user (tokens = characters / ratio)
VITE_DAILY_TOKEN_LIMIT=1000
# Characters per token (e.g., 5 chars = 1 token)
VITE_PRAYER_TOKEN_RATIO=5

# Developer Contact
VITE_DEV_EMAIL=your_dev_email@example.com

# Supabase Configuration
# Find these at: https://app.supabase.com -> Settings -> API
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Venice AI Configuration
# SECURITY: The Venice API key is now stored in Supabase Secrets, NOT in this file.
# To set the secret, run: supabase secrets set VENICE_API_KEY=your_key_here
# Or set it in the Supabase Dashboard: Project Settings -> Edge Functions -> Secrets
# The Edge Function at supabase/functions/process-prayer/index.ts retrieves it via Deno.env.get()

# Prayer Limits & Mana System
# Maximum characters allowed per prayer
VITE_MAX_PRAYER_CHARS=1500
# Daily Mana budget per user (Mana = characters / ratio)
VITE_DAILY_TOKEN_LIMIT=1000
# Characters per Mana (e.g., 5 chars = 1 Mana)
VITE_PRAYER_TOKEN_RATIO=5

# Developer Contact
VITE_DEV_EMAIL=your_dev_email@example.com
